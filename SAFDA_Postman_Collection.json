      "name": "🔐 MS Usuarios — :3001",
      "item": [
        {
          "name": "Login con Google",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.access_token) {",
                  "    pm.collectionVariables.set('jwt_token', res.access_token);",
                  "    pm.collectionVariables.set('usuario_id', res.perfil.id);",
                  "    console.log('✅ JWT guardado:', res.access_token);",
                  "}",
                  "pm.test('Login exitoso', function() {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"GOOGLE\",\n  \"token\": \"PEGA_AQUI_TU_ID_TOKEN_DE_GOOGLE\"\n}"
            },
            "url": {
              "raw": "{{base_usuarios}}/auth/login",
              "host": [
                "{{base_usuarios}}"
              ],
              "path": [
                "auth",
